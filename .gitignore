# Jack AI OS — .gitignore

# 原始对话归档（必须保存本地；默认不 push）
09_ARCHIVE/sessions/raw_archive/*
!09_ARCHIVE/sessions/raw_archive/.gitkeep

# 敏感信息
.env
.env.*
*.key
*.pem
*_secret*
*credentials*
*.p12
*.pfx

# 系统文件
.DS_Store
Thumbs.db
*.tmp
*.swp

# 大型媒体文件（视频/音频/图片原件，避免 push 超时）
*.mp4
*.mp3
*.mov
*.avi
*.m4v
*.m4a
*.wav
*.aiff
*.fcpbundle/
*.fcpcache/
*.flexolibrary

# 大型二进制文档
*.pdf
*.doc
*.docx
*.xmind
*.pptx

# 开发环境
node_modules/
__pycache__/
*.pyc
.venv/

# 代理配置（含密码）
02_TOOL_SYSTEM/proxy_configs/

# 旧 handoff 归档（含历史密码）
09_ARCHIVE/sessions/handoffs/

# os 目录（本地工作区，含配置模板和敏感关键字，不追踪）
os/

# 旧会话 raw 归档
09_ARCHIVE/sessions/raw_archive/

# Skill 分发包（含占位 key）
02_TOOL_SYSTEM/skills/
05_PROJECTS/DecodeX_Corp/outputs/PROJECT_DESIGN_v3.0.md

# 大型素材目录（视频/音频/PDF/图片原件，不入 git）
05_PROJECTS/DecodeX_Journal/b_roll/
05_PROJECTS/DecodeX_Oracle/source_materials/
